# ---- required ----
WZMM_ADMIN_KEY=change-me-to-a-random-48-hex
WZMM_POOL=/opt/wzmm/pool.json
WZMM_DB=/opt/wzmm/wzmm.db
WZMM_VIDEOS=/opt/wzmm/videos
WZMM_LEGACY=/opt/h3v2/data/render/out

# ---- behaviour ----
WZMM_PORT=8808
WZMM_ONLY_1080P=1
WZMM_COST_1080=80
WZMM_MAX_INFLIGHT=64
WZMM_EXPIRED_CAP=64
WZMM_DEAD=3
WZMM_402_COOLDOWN_H=6

# ---- retention / disk ----
WZMM_TTL_DAYS=3
WZMM_GC_WARN_GB=25
WZMM_DISK_SOFT_GB=20
WZMM_MIN_FREE_GB=6
WZMM_MIN_ACCEPT_GB=2
WZMM_GC_MIN_AGE_H=6
WZMM_GC_KEEP_NEWEST=20

# ---- webhook / security ----
WZMM_WEBHOOK_SECRET_FILE=/opt/wzmm/webhook.secret
WZMM_BROWSE_STATE=/opt/wzmm/browse_state.json
WZMM_CORS=

# ---- outbound proxy (fill in your own; never commit real creds) ----
PX_USER=user000000-region-XX-sid-{sid}-t-5
PX_PASS=REPLACE_ME
PX_TMPL=http://user000000-region-XX-sid-{sid}-t-5:REPLACE_ME@proxy.example.com:3000
PX_HOST=proxy.example.com
PX_PORT=3000
